# ---- Infrastructure --------------------------------------------------
# 5434, not 5432: the compose `db` service is published there to avoid
# colliding with a locally installed PostgreSQL. Inside compose, services
# reach it as db:5432.
DATABASE_URL=postgresql://documind:documind@localhost:5434/documind
# Separate disposable database (docker-compose `test-db`, port 5433).
# The suite drops/recreates schema here, so it must never point at dev.
TEST_DATABASE_URL=postgresql://documind:documind@localhost:5433/documind_test
REDIS_URL=redis://localhost:6379/0
ENV=development

# ---- Auth ------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Celery ----------------------------------------------------------
# Default to REDIS_URL. Split onto separate Redis DBs if the answer cache
# shares the instance -- a FLUSHDB aimed at the cache must not drop tasks.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=960
# MUST exceed CELERY_TASK_TIME_LIMIT. On Redis, acks_late is emulated with
# this timeout: set it too low and a still-running task is redelivered to a
# second worker.
CELERY_VISIBILITY_TIMEOUT=1800
CELERY_RESULT_EXPIRES=3600
CELERY_MAX_TASKS_PER_CHILD=100

# ---- Storage ---------------------------------------------------------
# local | s3  (s3 = any S3-compatible endpoint: AWS, Supabase, R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads
# S3_BUCKET=documind-documents
# S3_ENDPOINT_URL=https://<project>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_BYTES=26214400

# ---- Providers (model names are config, never hardcoded) -------------
# Gemini covers both embeddings and answers. One key, one base URL.
GEMINI_API_KEY=replace-me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# gemini | openai | fake
EMBEDDING_PROVIDER=gemini
# gemini-embedding-001, NOT gemini-embedding-2: the newer model is
# multimodal and self-normalizing but dropped the taskType parameter, and
# asymmetric document/query embedding matters more here than multimodality.
EMBEDDING_MODEL=gemini-embedding-001
# Must equal the Vector(...) width in migration 0004. Changing this is a
# migration, not a config edit. Gemini accepts 128..3072; 1536 scores the
# same on MTEB as 3072, so the existing column width costs nothing.
EMBEDDING_DIMENSIONS=1536

# Legacy, unused while EMBEDDING_PROVIDER=gemini.
# OPENAI_API_KEY=sk-replace-me

# gemini | anthropic | fake
LLM_PROVIDER=gemini
# The answering model: it sees the retrieved context. flash-lite because
# the free tier's request quota is the binding constraint, and grounded
# extraction over already-reranked context is not the hardest task there
# is. Bump to a flash model if answer quality turns out to be the limit.
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=1024
# Low, not zero: grounded extraction wants determinism, but exactly 0
# makes near-identical questions produce brittle phrasing.
LLM_TEMPERATURE=0.1
# PER-READ stall limit: how long ONE read may wait with no bytes. Does
# NOT bound the call -- a model emitting a token every 25s never trips it.
LLM_TIMEOUT_SECONDS=30.0
# TOTAL deadline for the whole generation. The other half of the
# guarantee: without it a slow-but-never-stalled stream runs forever.
LLM_TOTAL_TIMEOUT_SECONDS=120.0
# Retries apply ONLY before the first token reaches the client; after
# that a second attempt would splice two different answers together.
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_SECONDS=1.0
# A 429's Retry-After is obeyed when it is this short or shorter, since
# the server knows its own limit better than our guessed backoff. Longer
# than this we fail fast with the rate-limit message: honouring 90s
# inside a request handler is a hang with extra steps.
LLM_RETRY_AFTER_MAX_SECONDS=5.0

# The rewriter runs on EVERY request, cache hits included, and never sees
# retrieved text -- so it neither needs nor should pay for the answering
# model.
REWRITE_MODEL=gemini-3.5-flash-lite
REWRITE_MAX_TOKENS=128
REWRITE_HISTORY_TURNS=4

# Legacy, unused while LLM_PROVIDER=gemini.
# ANTHROPIC_API_KEY=sk-ant-replace-me

# hosted | passthrough | fake
RERANKER_PROVIDER=passthrough
RERANKER_MODEL=rerank-v3.5
# RERANKER_API_KEY=
RERANKER_BASE_URL=https://api.cohere.com/v2/rerank
# Short on purpose. Reranking happens inside the user's request, and the
# fallback (RRF order) is already a reasonable ranking -- so waiting is
# worth less here than answering slightly worse, immediately.
RERANKER_TIMEOUT_SECONDS=3.0
# Sent explicitly rather than inheriting Cohere's identical default:
# per-document truncation decides what the cross-encoder actually read,
# so it must not change under us when a provider changes a default.
RERANKER_MAX_TOKENS_PER_DOC=4096
# Cohere rejects >1000 documents. We send RETRIEVE_CANDIDATES (~50), so
# this guards a future config bump, not today's traffic.
RERANKER_MAX_DOCUMENTS=1000
# NB: a Cohere TRIAL key is 10 rerank req/min and 1000 calls/month.
# There is deliberately no client-side throttle here (unlike embedding's
# EMBED_REQUESTS_PER_MINUTE): spacing requests 6s apart to dodge a 429
# would blow the 3s budget above and guarantee the timeout it was meant
# to avoid. A 429 falls back to RRF order in milliseconds instead.

# ---- HTTP connection pool -------------------------------------------
# Shared by every provider call. Without it each call built its own
# client, which is its own connection pool -- a fresh TCP connection and
# TLS handshake per embedding batch, per rerank and per answer.
# Small on purpose: the pool caps in-flight provider requests, and on a
# free tier the per-minute request quota binds long before sockets do.
HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE_CONNECTIONS=10
# Kept under a typical provider load balancer's idle timeout (60s+). A
# pooled connection the far end already dropped is worse than none: the
# next request spends its budget discovering the socket is dead.
HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0
# Split from read because they mean different things: a hanging connect
# is a dead endpoint and should fail fast, a slow read is a model
# thinking.
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
# Backstop only -- every provider passes its own per-request timeout, so
# the pool can be shared by callers whose budgets differ by 10x. Never
# empty: in httpx that means "wait forever".
HTTP_DEFAULT_TIMEOUT_SECONDS=30.0

# ---- Chunking --------------------------------------------------------
PARENT_TOKENS=500
CHILD_TOKENS=125
CHILD_OVERLAP=20

# ---- Embedding -------------------------------------------------------
# Texts per HTTP request. Throttling counts REQUESTS, not texts.
EMBED_BATCH_SIZE=64
EMBED_MAX_RETRIES=3
EMBED_TIMEOUT_SECONDS=30.0
# Client-side floor on request spacing. 0 disables. Set BELOW the free
# tier's advertised limit on purpose: the published number is a ceiling
# the provider enforces, and sitting on it turns every jitter spike into
# a 429.
EMBED_REQUESTS_PER_MINUTE=90

# ---- Retrieval -------------------------------------------------------
RETRIEVE_CANDIDATES=50
RERANK_TOP_N=8
CONFIDENCE_THRESHOLD=0.3
CONTEXT_TOKEN_BUDGET=6000

# ---- Cache -----------------------------------------------------------
CACHE_TTL_SECONDS=3600

# ---- CORS -------------------------------------------------------------
# Comma-separated origins allowed to call this API DIRECTLY from a
# browser. Empty = disabled, which is correct for the same-origin
# Next.js BFF deployment (the browser never calls this API directly).
#
# Set it to test the API straight from a browser or a separate
# frontend. A wildcard '*' is refused at startup: it cannot be combined
# with credentials, so it would break every call rather than loosen
# anything.
CORS_ALLOW_ORIGINS=
