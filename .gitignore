# Secrets — .env.example is committed, .env never is.
.env
.env.local
# Any .env.<something> copy. A backup taken before flipping providers to
# live holds the same real keys the original does, and "it was only
# temporary" is how a key reaches a public remote.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtualenvs (this repo's dev venv lives in ./venv)
.venv/
venv/

# Local DBs / dev artifacts
*.db
*.sqlite3

# Local-disk storage backend writes here in dev; the files themselves are
# never committed, but the directory must exist for the backend to work.
uploads/*
!uploads/.gitkeep

# Eval run artefacts: regenerate with `python -m eval.calibrate`.
# Committing them would turn every run into a diff of live model output.
eval/results.json
