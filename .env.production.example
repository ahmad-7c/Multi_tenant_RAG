# ============================================================
# DocuMind production environment -- EXAMPLE. No real values.
# ============================================================
#
# Copy to .env.production ON THE SERVER ONLY:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production      # owner read/write, nothing else
#
# This file is committed. `.env.production` is NOT: it is ignored by
# .gitignore AND by .dockerignore, and must never be copied into an
# image. The runtime container receives it through compose `env_file`,
# so the values live in the container environment, never in a layer.
#
# Every value reading <GENERATE> or <PASTE> is a placeholder.
# `app/core/startup_checks.py` REFUSES TO BOOT in production on the
# known placeholders, so leaving one in place fails the deploy loudly
# instead of serving with a guessable signing key.
#
# Production keys MUST differ from development keys. A leaked dev key
# then costs a dev project rather than the live one.

# ---------------------------------------------------------- core ----
# Switches on the startup gate, and disables /docs, /redoc and
# /openapi.json (D-4). Nothing else keys off it.
ENV=production

# DATABASE_URL and REDIS_URL are assembled by docker-compose.prod.yml
# from the POSTGRES_* and REDIS_PASSWORD values below and passed in as
# environment, which overrides anything set here. Listed for
# completeness and deliberately left unset.
# DATABASE_URL=
# REDIS_URL=

# Generate each one:  openssl rand -hex 24      (48 characters)
# Hex, not base64: base64 contains / + and =, which have to be stripped
# before they reach the DSN docker-compose.prod.yml assembles -- and a
# stripped password is no longer the password you generated. Hex needs
# no escaping anywhere it is used.
# The database password IS the database. Treat it like one.
POSTGRES_USER=documind_prod
POSTGRES_PASSWORD=<GENERATE>
POSTGRES_DB=documind
REDIS_PASSWORD=<GENERATE>

# ------------------------------------------------------- identity ----
# 32 random bytes as hex:  openssl rand -hex 32      (64 characters)
# The same command startup_checks.py prints when it refuses a
# placeholder, so there is one instruction, not two.
# Rotating it invalidates every issued token, which is the point.
# Refused at boot if it is a known placeholder or under 32 characters.
JWT_SECRET_KEY=<GENERATE>
JWT_ALGORITHM=HS256
# One day. The BFF cookie Max-Age tracks this; raising one without the
# other leaves a cookie that outlives the token it carries.
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------- the edge ----
# The DuckDNS subdomain, e.g. documind-demo.duckdns.org. Never
# hard-coded in the repo -- deploy/Caddyfile reads $API_HOSTNAME.
# Locally this is `localhost`, which Caddy serves with its own
# locally-trusted certificate, so one file works in both places.
API_HOSTNAME=<PASTE>
# Where Let's Encrypt sends expiry warnings. Leave blank locally,
# where no public certificate is ever requested.
ACME_EMAIL=<PASTE>

# Empty, deliberately. The browser talks to the Next.js BFF and the
# BFF talks to this API server-side, so there is no cross-origin
# request to permit and no header worth advertising.
CORS_ALLOW_ORIGINS=

# Only safe because Caddy is the SOLE ingress and discards any inbound
# X-Forwarded-For, setting its own from the real connection address.
# If the API port is ever published directly, set this back to false
# the same day: a spoofable client IP is worse than none, because the
# per-IP login limiter would then throttle a forged address while the
# real attacker stays unlimited.
TRUST_FORWARDED_FOR=true

# ------------------------------------------------------- storage ----
STORAGE_BACKEND=local
# Inside the container, mapped to the `uploads` named volume shared by
# api and worker: the api writes bytes, the worker reads them back by
# storage_key. Separate volumes mean every ingestion fails on a
# missing file.
STORAGE_LOCAL_ROOT=uploads

# 4,000,000 bytes (D-2), under Caddy's 5MB body limit -- so an
# oversized upload is refused by the application with a sentence a
# user can read, not by the edge with a bare 413. The code default
# stays 25MiB for development.
MAX_UPLOAD_BYTES=4000000

# S3 is the alternative to the named volume and is not in use. A
# bucket would remove the api/worker shared-filesystem requirement
# entirely, which is what makes horizontal scaling possible later.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ----------------------------------------------------- providers ----
# One key serves both embeddings and answers. Presence is checked at
# boot; validity is NOT -- a startup probe would make booting depend
# on someone else's uptime and would bill for the privilege.
GEMINI_API_KEY=<PASTE>
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Changing either line above strands every stored vector. The startup
# guard detects the mismatch and refuses QUERIES ONLY, leaving uploads
# and auth serving. A re-ingest is the fix.
EMBEDDING_DIMENSIONS=1536

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=1024
# Two different limits. The first is the per-read stall timeout handed
# to httpx; the second is a real deadline for the whole request,
# including the retry and its backoff.
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1

# Cohere. `passthrough` is REFUSED at boot in production: fused RRF
# scores are rank reciprocals, not relevance, so CONFIDENCE_THRESHOLD
# cannot threshold them and the gate effectively opens -- which ships
# a system that answers everything. Hosted without a key is refused
# too, because that degrades to the same place silently.
RERANKER_PROVIDER=hosted
RERANKER_MODEL=rerank-v3.5
# Most people write this down as COHERE_API_KEY; Settings reads both.
RERANKER_API_KEY=<PASTE>
RERANKER_TIMEOUT_SECONDS=3

# ------------------------------------------- retrieval + the gate ----
# Calibrated at n=38 against THIS provider pair on 2026-10-31; see
# docs/eval-baseline.md. Both numbers are provider-specific. Changing
# a model without re-calibrating makes them meaningless rather than
# merely stale.
CONFIDENCE_THRESHOLD=0.3230
VECTOR_SIMILARITY_FLOOR=0.5594
RETRIEVE_CANDIDATES=50
RERANK_TOP_N=8
CONTEXT_TOKEN_BUDGET=6000
# Must match what the corpus was ingested with. A change silently
# alters what a recall figure means.
PARENT_TOKENS=500
CHILD_TOKENS=125
CHILD_OVERLAP=20

# -------------------------------------------------------- celery ----
# Broker and result backend default to REDIS_URL, which compose
# supplies. ALWAYS_EAGER is refused at boot: it runs ingestion inside
# the web request, holding an API worker for the length of an upload.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_MAX_TASKS_PER_CHILD=100
# The visibility timeout must exceed the task time limit, or Redis
# redelivers a task that is still running and the document ingests
# twice.
CELERY_TASK_TIME_LIMIT=960
CELERY_VISIBILITY_TIMEOUT=1800

# --------------------------------------------- limits and budget ----
# Refused at boot if false. On a public IPv4 the answer endpoint
# spends real provider money per request.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANSWER_PER_MINUTE=30
RATE_LIMIT_ANSWER_BURST=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=3
MAX_CONCURRENT_STREAMS_PER_ORG=3

# 0 means DISABLED, not "zero allowed". Both at 0 is refused at boot:
# that is exactly the configuration in which a free-tier key is
# drained overnight with nothing to stop it. The global limit caps the
# whole deployment; the per-org limit caps one tenant.
BUDGET_DAILY_GLOBAL_UNITS=20000
BUDGET_DAILY_ORG_UNITS=5000

CACHE_TTL_SECONDS=3600
# ====================================================================
# EVERY REMAINING SETTING, at its code default.
# ====================================================================
# Commented out on purpose: an uncommented copy of a default is a
# second place the value lives, and the two drift. They are listed so
# this file is a complete inventory of what the application reads --
# `tests/test_env_production_example.py` fails if a new Setting is
# added without appearing here.

# TEST_DATABASE_URL=          # leave unset: the suite's database. Setting it here would point production at it
# CELERY_BROKER_URL=          # leave unset: defaults to REDIS_URL, which compose supplies
# CELERY_RESULT_BACKEND=          # leave unset: defaults to REDIS_URL, which compose supplies
# CELERY_TASK_SOFT_TIME_LIMIT=900
# CELERY_RESULT_EXPIRES=3600
# OPENAI_API_KEY=          # leave unset: unused since the Gemini migration
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ANTHROPIC_API_KEY=          # leave unset: unused since the Gemini migration
# LLM_RETRY_BASE_SECONDS=1.0
# LLM_RETRY_AFTER_MAX_SECONDS=5.0
# REWRITE_MODEL=gemini-3.5-flash-lite
# REWRITE_MAX_TOKENS=128
# REWRITE_HISTORY_TURNS=4
# JUDGE_MODEL=gemini-3.5-flash-lite
# JUDGE_TEMPERATURE=0.0
# JUDGE_MAX_TOKENS=200
# JUDGE_MAX_RETRIES=1
# JUDGE_CACHE_ENABLED=True
# RERANKER_BASE_URL=https://api.cohere.com/v2/rerank
# RERANKER_MAX_TOKENS_PER_DOC=4096
# RERANKER_MAX_DOCUMENTS=1000
# HTTP_MAX_CONNECTIONS=20
# HTTP_MAX_KEEPALIVE_CONNECTIONS=10
# HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0
# HTTP_CONNECT_TIMEOUT_SECONDS=5.0
# HTTP_DEFAULT_TIMEOUT_SECONDS=30.0
# OCR_MIN_CHARS_PER_PAGE=25
# CLEAN_EDGE_LINES=3
# CLEAN_MIN_PAGES_FOR_HEADER_DETECTION=3
# CLEAN_REPEAT_RATIO=0.6
# CLEAN_MAX_HEADER_CHARS=80
# EMBED_BATCH_SIZE=64
# EMBED_MAX_RETRIES=3
# EMBED_RETRY_BASE_SECONDS=5.0
# EMBED_TIMEOUT_SECONDS=30.0
# EMBED_REQUESTS_PER_MINUTE=90
# RETRIEVE_PER_LEG=60
# RRF_K=60
# HNSW_EF_SEARCH=100
# HNSW_ITERATIVE_SCAN=relaxed_order
# HNSW_MAX_SCAN_TUPLES=20000
# TS_CONFIG=english
# RATE_LIMIT_REDIS_URL=          # leave unset: defaults to REDIS_URL; a separate instance is possible, not wanted
# RATE_LIMIT_DEFAULT_BURST=60
# RATE_LIMIT_LOGIN_BURST=5
# RATE_LIMIT_REGISTER_BURST=3
# STREAM_SLOT_TTL_SECONDS=180
# BUDGET_KEY_TTL_SECONDS=172800
# CACHE_REDIS_URL=          # leave unset: defaults to REDIS_URL
